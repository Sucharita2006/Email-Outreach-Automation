# ============================================================
#  .env.example — Copy to .env and fill in your values
#  NEVER commit .env to git
# ============================================================

# ── LLM ──────────────────────────────────────────────────────
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model preferences (can override per request)
OPENROUTER_PRIMARY_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.1-70b-instruct
OPENROUTER_BATCH_MODEL=google/gemini-flash-1.5

# ── Contact Discovery ─────────────────────────────────────────
# Hunter.io: https://hunter.io/api-keys
HUNTER_API_KEY=your_hunter_io_api_key_here
HUNTER_BASE_URL=https://api.hunter.io/v2

# ── Structured Web Search ─────────────────────────────────────
# Serper: https://serper.dev/api-key
SERPER_API_KEY=your_serper_dev_api_key_here
SERPER_BASE_URL=https://google.serper.dev

# ── Company Registry ──────────────────────────────────────────
# OpenCorporates: https://opencorporates.com/api_accounts/new
OPENCORPORATES_API_TOKEN=your_opencorporates_token_here
OPENCORPORATES_BASE_URL=https://api.opencorporates.com/v0.4

# ── Personality Profiling ─────────────────────────────────────
# Humantic AI: https://humantic.ai
HUMANTIC_API_KEY=your_humantic_ai_api_key_here
HUMANTIC_BASE_URL=https://api.humantic.ai/v1

# ── Gmail (Optional — Sprint 11) ──────────────────────────────
# Google Cloud Console: https://console.cloud.google.com/
GMAIL_CLIENT_ID=your_google_oauth_client_id_here
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# ── Database ──────────────────────────────────────────────────
# SQLite for local dev (default). Switch to PostgreSQL for production.
DATABASE_URL=sqlite:///./outreach.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/email_outreach

# ── App Settings ──────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change_this_to_a_random_secret_key_min_32_chars

# ── Nonprofit Profile (used in email prompts) ─────────────────
NONPROFIT_NAME=Your Organization Name
NONPROFIT_MISSION=Your mission statement in 2-3 sentences
NONPROFIT_SENDER_NAME=Your Name
NONPROFIT_SENDER_ROLE=Your Title

# ── Cache TTL Settings (in seconds) ──────────────────────────
HUNTER_CACHE_TTL_SECONDS=1209600      # 14 days
SERPER_CACHE_TTL_SECONDS=604800       # 7 days
OPENCORPORATES_CACHE_TTL_SECONDS=2592000  # 30 days
HUMANTIC_CACHE_TTL_SECONDS=7776000    # 90 days
INDIVIDUAL_ANALYSIS_CACHE_TTL_SECONDS=2592000  # 30 days
COMPANY_ANALYSIS_CACHE_TTL_SECONDS=604800      # 7 days

# ── Rate Limiting ─────────────────────────────────────────────
LLM_BATCH_CONCURRENCY=10             # Parallel LLM calls (Semaphore)
RESEARCH_BATCH_CONCURRENCY=5         # Parallel research API calls

# ── Follow-up Scheduling ──────────────────────────────────────
FOLLOWUP_1_DAYS=7
FOLLOWUP_2_DAYS=14
